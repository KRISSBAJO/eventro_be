// Eventro data model.
// Money is stored in integer cents. Prices on ticket types are the all-in price the fan pays.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAN
  ORGANIZER
  ADMIN
}

enum Category {
  CONCERTS
  SPORTS
  COMEDY
  THEATER
  FESTIVALS
  FAMILY
  NIGHTLIFE
  CONFERENCE
  WORKSHOP
  /// church services, worship nights, crusades, conferences and retreats
  FAITH
  /// food festivals, tastings, supper clubs, brunches and drinks events
  FOOD
  OTHER
}

enum EventStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  CANCELLED
}

enum Visibility {
  PUBLIC
  UNLISTED
}

enum FeeMode {
  BUYER // fee is inside the all-in price; organizer keeps the base price
  ORGANIZER // fan pays the listed price; fee comes out of the payout
}

enum MemberRole {
  ADMIN
  MANAGER
  DOOR
}

enum MemberStatus {
  ACTIVE
  INVITED
}

enum PayoutSchedule {
  DAILY
  WEEKLY
}

/// How a ticket type is priced: a fixed price, or pay what you want (the fan picks a base amount within the tier's limits).
enum TicketPricing {
  FIXED
  PWYW
}

/// SALE: bought at checkout (free tickets included). COMP: a complimentary ticket issued by the organizer ($0, no payment).
enum OrderKind {
  SALE
  COMP
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TicketStatus {
  ACTIVE
  TRANSFER_PENDING
  LISTED
  CHECKED_IN
  VOID
}

enum RefundStatus {
  OPEN
  APPROVED
  PARTIAL
  DENIED
}

enum FraudStatus {
  OPEN
  BLOCKED
  WATCHING
  ALLOWED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  roles        Role[]   @default([FAN])
  /// Set by an admin: the account can't sign in or use the API until it's lifted.
  suspendedAt   DateTime?
  suspendReason String?
  /// Set when the password changes (e.g. a reset); sign-in tokens issued before it stop working.
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    OrganizationMember[]
  orders         Order[]
  tickets        Ticket[]            @relation("TicketOwner")
  auditLogs      AuditLog[]
  venueClaims    VenueClaim[]
  passwordResets PasswordReset[]
  sessions       Session[]
  pushDevices    PushDevice[]
  savedEvents    SavedEvent[]
  /// Push notification choices, e.g. { "priceDrops": false }. Missing keys mean on.
  notifyPrefs    Json?
}

/// Long-lived sign-ins for the mobile app: a refresh token (only its SHA-256 hash is stored) per device.
/// Short-lived access tokens are minted from it; signing out, a password change or an admin revokes it.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceName String?
  platform   String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A phone that receives push notifications (Expo push token).
model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  platform   String?
  deviceName String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set when Expo reports the token is no longer registered, or the user signs out on that phone.
  disabledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Every push notification Eventro sends (or skips), like EmailLog. `dedupeKey` stops repeats (e.g. one reminder per ticket holder per event).
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  title     String
  body      String
  data      Json?
  status    String   @default("SENT")
  error     String?
  dedupeKey String?  @unique
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([kind, createdAt])
}

/// "Forgot password" links. Only a SHA-256 hash of the token is stored; each link works once, for an hour.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Organization {
  id             String         @id @default(cuid())
  name           String
  website        String?
  supportEmail   String
  about          String?
  payoutSchedule PayoutSchedule @default(DAILY)
  // Bank details live with the payment provider (e.g. Stripe Connect); only a display hint is stored here.
  stripeAccountId String?
  bankLast4      String?
  bankName       String?
  bankCountry    String?
  /// "stripe" (Stripe Connect, hosted onboarding) or "paystack" (subaccount; NG, GH, KE, ZA).
  payoutProvider String?
  /// Paystack subaccount (ACCT_…). Paystack holds the account number; we keep the bank, last 4 and the holder's name.
  paystackSubaccount String?
  bankCode        String?
  bankAccountName String?
  /// After the bank account changes, payouts wait until this time (and every org admin is emailed).
  payoutHoldUntil DateTime?
  payoutUpdatedAt DateTime?
  /// Checked by Eventro (shown as a badge; skips the "new organizer" review flag).
  verifiedAt     DateTime?
  /// Suspended organizers can't submit events, and sales on their events are paused.
  suspendedAt    DateTime?
  suspendReason  String?
  createdAt      DateTime       @default(now())

  members OrganizationMember[]
  events  Event[]
  venueBookings VenueBooking[]
}

model OrganizationMember {
  id        String       @id @default(cuid())
  orgId     String
  userId    String?
  email     String
  role      MemberRole
  status    MemberStatus @default(INVITED)
  createdAt DateTime     @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orgId, email])
  @@index([userId])
}

model Venue {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String
  city      String
  /// ISO 3166-1 alpha-2, e.g. "NG"
  country   String?
  /// State, province or region name
  region     String?
  postalCode String?
  /// IANA time zone, e.g. "Africa/Lagos" (from the venue's location)
  timezone   String?
  lat       Float?
  lng       Float?
  capacity  Int?
  /// Official seat map for this venue (same shape as Event.seatMap), kept by its managers or Eventro.
  layout    Json?
  about     String?
  imageUrl  String?
  website   String?
  phone     String?
  /// Checked by Eventro (shown as a badge; listed first in search).
  verifiedAt DateTime?
  /// Hidden from search and venue pages (duplicates, spam, closed venues).
  hiddenAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  events Event[]
  claims VenueClaim[]
  listing   VenueListing?
  blackouts VenueBlackout[]
  bookings  VenueBooking[]
}

/// Someone asking to manage a venue's page. Approved claims make that person a manager of the venue.
model VenueClaim {
  id         String    @id @default(cuid())
  venueId    String
  userId     String
  /// owner, manager or staff: who they are at the venue
  role       String
  message    String
  website    String?
  /// PENDING, APPROVED, REJECTED or REVOKED
  status     String    @default("PENDING")
  /// The claimant added this venue to Eventro themselves (POST /me/venues): it stays hidden until the claim is
  /// approved, and approving it shows the venue. Hidden venues with no such claim were hidden by Eventro.
  newVenue   Boolean   @default(false)
  note       String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime  @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId])
  @@index([status, createdAt])
}

model Event {
  id          String      @id @default(cuid())
  slug        String      @unique
  orgId       String
  venueId     String?
  title       String
  subtitle    String      @default("")
  description String      @default("")
  category    Category
  imageUrl    String?
  startsAt    DateTime
  doorsAt     DateTime?
  endsAt      DateTime?
  timezone    String      @default("UTC")
  online      Boolean     @default(false)
  streamUrl   String?
  status      EventStatus @default(DRAFT)
  reviewNote  String?
  visibility  Visibility  @default(PUBLIC)
  feeMode     FeeMode     @default(BUYER)
  /// ISO 4217. Ticket prices and orders are in this currency's minor units (kobo for NGN).
  currency    String      @default("USD")
  salesPaused Boolean     @default(false)
  /// Set when the organizer or Eventro cancels the event (status CANCELLED); every paid order is refunded.
  cancelledAt  DateTime?
  cancelReason String?
  /// Seat map layout: stage + sections (arc / rect / ga), each linked to a ticket type.
  seatMap     Json?
  /// Photos and videos hosted on mediaEX, in display order: [{ id, kind: "image" | "video" }]. The first image is the cover.
  media       Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  venue       Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  ticketTypes TicketType[]
  holds       Hold[]
  orders      Order[]
  tickets     Ticket[]
  promos      Promo[]
  priceDrops  PriceDrop[]
  priceWatches PriceWatch[]
  savedBy      SavedEvent[]
  venueBooking VenueBooking?
  resaleListings ResaleListing[]
  scanAttempts   ScanAttempt[]
  guaranteeClaims GuaranteeClaim[]

  /// Fan resale: allowed at all, the most a ticket may be listed for (% of face value; null = no cap),
  /// the organizer's cut of each resale (per mille), transfers allowed, and how long before the start
  /// both stop (minutes).
  resaleEnabled         Boolean @default(true)
  resaleCapPercent      Int?    @default(150)
  resaleRoyaltyPermille Int     @default(0)
  transfersEnabled      Boolean @default(true)
  transferCutoffMinutes Int     @default(60)

  /// Charity donations at checkout: on or off, the cause (snapshotted on each order), a short description, up to 4
  /// suggested amounts and an optional minimum (minor units). Eventro collects them on the organizer's behalf and pays
  /// them out with the organizer's payout; the organizer passes them to the cause.
  donationsEnabled       Boolean @default(false)
  donationCause          String?
  donationDescription    String?
  donationSuggestedCents Int[]   @default([])
  donationMinCents       Int?
  /// Most live complimentary tickets (comps) the event may have; null = no limit beyond the tiers' capacity.
  compLimit              Int?
  guestList              GuestListEntry[]
  guestCheckIns          GuestCheckIn[]

  @@index([status, startsAt])
  @@index([orgId])
}

model TicketType {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  description String    @default("")
  /// All-in price the fan pays, in cents.
  priceCents  Int
  capacity    Int
  sold        Int       @default(0)
  maxPerOrder Int       @default(8)
  /// Display and seating order: 0 is the top tier (e.g. Special VIP), shown first and seated nearest the stage.
  sortOrder   Int       @default(0)
  /// What this ticket includes, shown to fans as a checklist ("Priority entry", "Lounge access"…).
  perks       String[]  @default([])
  /// Optional short label on the ticket, e.g. "Best view" or "Most popular".
  badge       String?
  /// The ticket's look on the website and in the app: early, standard, vip, vvip, platinum or table. Null = picked from the name.
  style       String?
  /// FIXED: priceCents is the price. PWYW: the fan picks a base amount between pwywMinCents and pwywMaxCents (null = the
  /// API's ceiling); priceCents is then the all-in price of the minimum ("from"). Amounts are base amounts, like the
  /// organizer's basePriceCents: the event's fee mode adds Eventro's fee on top (BUYER) or takes it out (ORGANIZER).
  pricing            TicketPricing @default(FIXED)
  pwywMinCents       Int?
  pwywSuggestedCents Int?
  pwywMaxCents       Int?
  pwywQuickPicks     Int[]         @default([])
  salesStart  DateTime?
  salesEnd    DateTime?

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  holds   Hold[]
  orders  Order[]
  tickets Ticket[]

  @@index([eventId])
}

model Hold {
  id           String     @id @default(cuid())
  eventId      String
  ticketTypeId String
  /// Seat map section the fan chose, if any.
  sectionId    String?
  /// Seats reserved by this hold: [{ section, row, seat }]. Row and seat are null in standing sections.
  seats        Json?
  quantity     Int
  /// Pay what you want: the base amount per ticket the fan chose (checked against the tier's limits).
  amountCents  Int?
  /// The donation the fan chose before checkout moved elsewhere (the app hands card payments to the website); the
  /// quote and the order use it when none is sent, and check it again. 0 = none.
  donationCents Int     @default(0)
  userId       String?
  status       HoldStatus @default(ACTIVE)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  order      Order?

  @@index([ticketTypeId, status, expiresAt])
}

model Order {
  id              String      @id // human-friendly code, e.g. EVT-7F3K-2Q9M
  eventId         String
  ticketTypeId    String
  holdId          String?     @unique
  buyerId         String?
  email           String
  buyerName       String
  quantity        Int
  unitCents       Int
  subtotalCents   Int
  protectionCents Int         @default(0)
  discountCents   Int         @default(0)
  totalCents      Int
  refundedCents   Int         @default(0)
  promoCode       String?
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  provider        String // "stripe" | "mock"
  paymentRef      String?     @unique
  clientIp        String?
  createdAt       DateTime    @default(now())
  paidAt          DateTime?
  kind            OrderKind   @default(SALE)
  /// A charity donation added at checkout (inside totalCents, no Eventro fee), the cause it was for, and how much of
  /// it has been refunded (also counted in refundedCents). Ticket revenue and guarantee shares leave it out.
  donationCents         Int     @default(0)
  donationCause         String?
  donationRefundedCents Int     @default(0)
  /// Donation refunds made after the organizer had already been paid for this order: owed by them to Eventro.
  donationOwedCents     Int     @default(0)
  /// Comps: the group label ("Press", "Artist"…), the organizer's private note, who issued it and when it was revoked.
  compGroup       String?
  compNote        String?
  compIssuedById  String?
  compRevokedAt   DateTime?

  event      Event          @relation(fields: [eventId], references: [id])
  ticketType TicketType     @relation(fields: [ticketTypeId], references: [id])
  hold       Hold?          @relation(fields: [holdId], references: [id])
  buyer      User?          @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  tickets    Ticket[]
  refunds    RefundRequest[]
  fraudFlag  FraudFlag?
  gift       Gift?
  /// set on orders that bought a fan-resale listing (one ticket, handed over from the seller)
  resaleListingId String?        @unique
  resaleListing   ResaleListing? @relation(fields: [resaleListingId], references: [id])
  guaranteeClaims GuaranteeClaim[]

  @@index([eventId, status, paidAt])
  @@index([eventId, kind])
  @@index([email])
}

model Ticket {
  id           String       @id // order code + "-01"
  orderId      String
  eventId      String
  ticketTypeId String
  ownerId      String?
  holderName   String
  holderEmail  String
  section      String?
  row          String?
  seat         Int?
  status       TicketStatus @default(ACTIVE)
  transferTo   String?
  listCents    Int?
  checkedInAt  DateTime?
  checkedInBy  String?
  /// a pending transfer goes back to the holder after this
  transferExpiresAt DateTime?
  /// the ticket was sold on fan resale; the buyer got a new ticket for the same seat
  resoldAt     DateTime?
  /// Bumped when the ticket changes hands (transfer, gift claim): the QR seed changes, so the old holder's saved codes stop working.
  qrVersion    Int          @default(0)
  /// Which door scanner checked it in (offline scans sync later)
  checkedInDevice String?
  /// Bought on Eventro fan resale: its Eventro Guarantee claims are paid by Eventro, not the organizer (stays so after
  /// a transfer). Every other ticket from a paid order is covered too, at the organizer's cost (see src/guarantee).
  resaleGuarantee Boolean   @default(false)
  createdAt    DateTime     @default(now())

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      Event      @relation(fields: [eventId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  owner      User?      @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  listings   ResaleListing[]
  scanAttempts   ScanAttempt[]
  guaranteeClaim GuaranteeClaim?

  /// A reserved seat can only be sold once (GA tickets have no seat, so they don't collide).
  @@unique([eventId, section, row, seat])
  @@index([holderEmail])
  @@index([transferTo])
}

model Promo {
  id        String  @id @default(cuid())
  eventId   String
  code      String
  percent   Int
  limit     Int?
  used      Int     @default(0)
  active    Boolean @default(true)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
}

model RefundRequest {
  id          String       @id @default(cuid())
  orderId     String
  reason      String
  status      RefundStatus @default(OPEN)
  amountCents Int?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model FraudFlag {
  id        String      @id @default(cuid())
  orderId   String      @unique
  score     Int
  reasons   String[]
  status    FraudStatus @default(OPEN)
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  data      Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

/// Files uploaded to mediaEX through Eventro. Lets the API check that people only attach media they uploaded.
model MediaUpload {
  id        String   @id // mediaEX asset id (ast_…)
  userId    String
  kind      String // "image" | "video"
  fileName  String
  size      Int
  createdAt DateTime @default(now())

  @@index([userId])
}

/// People who asked for drops and presales by email. `token` is the secret in their preferences/unsubscribe link.
model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  token          String    @unique
  source         String    @default("footer") // where they signed up: footer, newsletter page…
  interests      String[]  @default([]) // event categories; empty means everything
  city           String? // city slug, for local drops
  clientIp       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  unsubscribedAt DateTime?

  @@index([clientIp, createdAt])
}

/// A ticket type got cheaper on a published event. Fans watching the event (and matching newsletter subscribers) hear about it.
model PriceDrop {
  id           String   @id @default(cuid())
  eventId      String
  ticketTypeId String
  ticketName   String
  fromCents    Int
  toCents      Int
  currency     String
  /// How many people were emailed; 0 when the drop was too small or another alert went out recently.
  notified     Int      @default(0)
  skipReason   String?
  createdBy    String?
  createdAt    DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

/// "Tell me if the price drops" on an event page. `token` is the secret in the stop link.
model PriceWatch {
  id         String    @id @default(cuid())
  eventId    String
  email      String
  userId     String?
  token      String    @unique
  clientIp   String?
  notifiedAt DateTime?
  stoppedAt  DateTime?
  createdAt  DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([clientIp, createdAt])
}

/// A venue's listing for hire on Eventro: whether organizers can book it, and on what terms. One per venue, kept by
/// the venue's approved managers (VenueClaim). Payment happens outside Eventro for now; the price is shown only.
model VenueListing {
  venueId       String   @id
  /// Shown in venue search and bookable when true
  active        Boolean  @default(false)
  /// HOUR, DAY or QUOTE (ask the venue)
  priceMode     String   @default("QUOTE")
  /// Price per hour or per day in the smallest unit of `currency`; null with QUOTE
  priceCents    Int?
  currency      String   @default("USD")
  /// Shortest booking, in hours
  minHours      Int      @default(1)
  /// How many days ahead a booking must be requested
  noticeDays    Int      @default(7)
  /// Setup and cleanup time kept free around each booking (minutes)
  bufferMinutes Int      @default(60)
  /// Most guests for a hired event (may be lower than the venue's full capacity)
  capacity      Int?
  amenities     String[] @default([])
  rules         String?
  /// Extra photos for the listing: [{ url, alt? }]
  photos        Json?
  /// Confirm requests automatically when the time is free
  instantBook   Boolean  @default(false)
  /// Weekly opening hours in the venue's time zone: [{ day: 0-6 (Sunday = 0), open: "09:00", close: "23:00" }].
  /// Null means any time.
  hours         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([active])
}

/// Time a venue can't be booked (private use, maintenance, holidays). Times are the venue's wall-clock time stored
/// as UTC, like event times.
model VenueBlackout {
  id          String   @id @default(cuid())
  venueId     String
  startsAt    DateTime
  endsAt      DateTime
  note        String?
  createdById String?
  createdAt   DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, startsAt])
}

/// A request to hire a venue, and what became of it. Times are the venue's wall-clock time stored as UTC (like event
/// times); blockFrom/blockTo add the listing's setup and cleanup buffer and are what other bookings can't overlap.
/// Pending requests hold their time until holdUntil; confirming one declines the others that overlap it.
model VenueBooking {
  id            String    @id @default(cuid())
  /// Shown to people, e.g. VB-7KQ2-M9XD
  code          String    @unique
  venueId       String
  orgId         String
  requestedById String?
  /// The event this booking is for (an event waits for the venue's confirmation before it can be submitted)
  eventId       String?   @unique
  startsAt      DateTime
  endsAt        DateTime
  blockFrom     DateTime
  blockTo       DateTime
  guests        Int?
  message       String?
  /// PENDING, CONFIRMED, DECLINED, EXPIRED or CANCELLED
  status        String    @default("PENDING")
  holdUntil     DateTime
  /// The price the venue quoted (or the listing price when the request was made); paid outside Eventro for now
  quotedCents   Int?
  currency      String?
  decidedById   String?
  decidedAt     DateTime?
  declineReason String?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  venue    Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  org      Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  event    Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  messages VenueBookingMessage[]

  @@index([venueId, status, blockFrom])
  @@index([orgId, createdAt])
  @@index([status, holdUntil])
}

/// A short message between the organizer and the venue on one booking.
model VenueBookingMessage {
  id        String   @id @default(cuid())
  bookingId String
  userId    String?
  /// ORGANIZER or VENUE: which side wrote it
  side      String
  body      String
  createdAt DateTime @default(now())

  booking VenueBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
}

/// An event a fan hearted. Kept on the server so saves follow them between the website and the app.
model SavedEvent {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, createdAt])
}

/// Every email Eventro tried to send, for support and the admin console.
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  kind       String // newsletter.welcome, price_drop, order.receipt, broadcast…
  /// SENT, FAILED, or SKIPPED (no email provider configured)
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([kind, createdAt])
  @@index([to])
}

/// An order bought for someone else. Its tickets are held (TRANSFER_PENDING) until the gift is delivered and the
/// recipient claims them; `token` is the secret in the gift link.
model Gift {
  id             String    @id @default(cuid())
  orderId        String    @unique
  recipientName  String
  recipientEmail String
  message        String    @default("")
  /// leave the price off the gift email and page
  hidePrice      Boolean   @default(true)
  sendAt         DateTime
  sentAt         DateTime?
  claimedAt      DateTime?
  claimedBy      String?
  token          String    @unique
  createdAt      DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([sentAt, sendAt])
  @@index([recipientEmail])
}

/// A fan selling a ticket on Eventro's official resale. The buyer pays through normal checkout; the seller's ticket
/// is cancelled and the buyer gets a new one for the same seat. The seller is paid once the event has happened.
model ResaleListing {
  id         String    @id @default(cuid())
  ticketId   String
  eventId    String
  sellerId   String
  /// what the buyer pays (all-in), and the ticket's original price
  priceCents Int
  faceCents  Int
  currency   String
  /// ACTIVE, HELD (someone is checking out), SOLD or CANCELLED
  status     String    @default("ACTIVE")
  heldUntil  DateTime?
  heldBy     String?
  cancelReason String?
  createdAt  DateTime  @default(now())
  soldAt     DateTime?

  /// After a sale: Eventro's fee, the organizer's cut, and what the seller gets
  sellerFeeCents     Int?
  royaltyCents       Int?
  payoutCents        Int?
  /// NONE, PENDING (until after the event), AVAILABLE, HELD (by an admin) or PAID
  payoutStatus       String    @default("NONE")
  payoutAvailableAt  DateTime?
  paidOutAt          DateTime?
  payoutNote         String?

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  order  Order?

  @@index([eventId, status])
  @@index([sellerId])
  @@index([payoutStatus])
}

/// What the door scanner saw. ADMITTED is a successful check-in; everything else is a rejected scan.
enum ScanResult {
  ADMITTED
  ALREADY_USED
  VOID
  WRONG_EVENT
  INVALID
  EXPIRED_CODE
  NOT_FOUND
  TRANSFER_PENDING
}

/// How the scan reached the API: a QR scanned online, a ticket code typed in, or an offline scan synced later.
enum ScanMethod {
  QR
  MANUAL
  OFFLINE
}

/// Every door scan attempt, successful or not (check-ins alone live on Ticket). Only what the scan needs: no codes,
/// names or IPs. `ticketId` is null when the code was unreadable or matched no ticket. Offline scans keep the time the
/// scanner made them; `dedupeKey` (a hash of scanner, ticket and time) stops a re-sent sync from logging twice.
model ScanAttempt {
  id        String     @id @default(cuid())
  eventId   String
  ticketId  String?
  result    ScanResult
  method    ScanMethod
  deviceId  String?
  /// the staff member who scanned
  userId    String?
  at        DateTime
  dedupeKey String?    @unique
  createdAt DateTime   @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId, at])
  @@index([eventId, at])
}

/// A name on the event's guest list, without a ticket: the person and up to 10 plus-ones. `arrived` counts how many
/// of the party (1 + plusOnes) are in. Each arrival is logged in GuestCheckIn, the guest list's door log.
model GuestListEntry {
  id             String    @id @default(cuid())
  eventId        String
  name           String
  email          String?
  plusOnes       Int       @default(0)
  group          String?
  note           String?
  arrived        Int       @default(0)
  firstArrivedAt DateTime?
  lastArrivedAt  DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkIns GuestCheckIn[]

  @@index([eventId, name])
}

/// The guest list's door log, beside the ticket scan log (ScanAttempt): every guest-list check-in, online or synced
/// from an offline scanner. `guests` is how many of the party it let in (0 when they were all in already: result
/// ALREADY_USED). Like ScanAttempt it keeps only what the door needs (no names, emails or IPs); offline check-ins keep
/// the scanner's time, and `dedupeKey` (a hash of scanner and check-in id) stops a re-sent sync from counting twice.
model GuestCheckIn {
  id        String     @id @default(cuid())
  eventId   String
  entryId   String?
  guests    Int
  result    ScanResult
  offline   Boolean    @default(false)
  deviceId  String?
  /// the staff member who checked them in
  userId    String?
  at        DateTime
  dedupeKey String?    @unique
  createdAt DateTime   @default(now())

  event Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entry GuestListEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@index([eventId, at])
  @@index([entryId, at])
}

enum GuaranteeClaimStatus {
  PENDING
  APPROVED
  DECLINED
}

/// An Eventro Guarantee (scan guarantee) claim: "it didn't scan, give me my money back". One per ticket, by its
/// holder, declined automatically when the ticket was checked in, otherwise decided by Eventro. Approval refunds that
/// ticket's all-in share of its order. Fan resale tickets: Eventro pays (the seller's payout is untouched). Every other
/// paid ticket: the organizer pays their share out of their payout and Eventro returns its fee (see src/guarantee).
/// `amountCents` is what the guarantee refunds, for cost totals.
model GuaranteeClaim {
  id           String               @id @default(cuid())
  ticketId     String               @unique
  orderId      String
  eventId      String
  /// the holder who claimed
  userId       String?
  /// DID_NOT_SCAN, TURNED_AWAY or OTHER
  reason       String
  details      String?
  status       GuaranteeClaimStatus @default(PENDING)
  /// decided by the scan log rather than a person
  auto         Boolean              @default(false)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  amountCents  Int
  currency     String
  /// Who pays an approved claim: EVENTRO (fan resale tickets) or ORGANIZER (every other paid ticket)
  payer        String               @default("EVENTRO")
  /// ORGANIZER claims, once refunded: the organizer's part of the refund (their share of the ticket, which comes out
  /// of their payout). Eventro covers the rest of `amountCents`: its fee and any ticket protection.
  organizerCents     Int            @default(0)
  /// ORGANIZER claims refunded after the organizer had already been paid for the order: what they owe Eventro
  organizerOwedCents Int            @default(0)
  /// NONE, PENDING (being sent), REFUNDED or FAILED (admins can retry)
  refundStatus String               @default("NONE")
  refundError  String?
  refundedAt   DateTime?
  /// which emails went out (claim.received, claim.approved…), so each is sent once
  noticesSent  String[]             @default([])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([refundStatus])
  @@index([eventId])
}

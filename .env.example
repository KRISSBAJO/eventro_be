# Copy to .env and fill in.

# Postgres. `npm run db:start` runs a local one on 55432 with these credentials.
DATABASE_URL=postgresql://eventro:eventro-local-dev@127.0.0.1:55432/eventro

# HTTP
PORT=4000
# Comma-separated origins allowed to call the API (the Next.js site).
CORS_ORIGINS=http://127.0.0.1:3500,http://localhost:3500

# Auth: long random strings. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Signs rotating ticket QR codes. Different from JWT_SECRET.
TICKET_QR_SECRET=

# Stripe (test mode keys start with sk_test_ / whsec_).
# Leave empty to use the built-in "mock" payment provider for local development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Fees, in per-mille (35 = 3.5%).
ORGANIZER_FEE_PERMILLE=35
RESALE_FEE_PERMILLE=50

# First admin account: this email gets the ADMIN role when it signs up.
ADMIN_EMAIL=

# mediaEX (photo and video hosting). Create an API key with "upload" scope (or "full") under Developers in mediaEX.
# Without a key, organizers can't upload media and events use stock cover images.
MEDIAEX_URL=http://localhost:3400
MEDIAEX_API_KEY=

# Optional: your own admin login, created or updated by `npm run db:seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Paystack (NGN, GHS, KES, ZAR). Test keys start with sk_test_. Webhook URL: <api>/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
# Where the website runs (Paystack sends fans back here after paying)
WEB_URL=http://127.0.0.1:3500
# Optional: ipinfo.io token to find a visitor's country by IP when your host doesn't send a country header
IPINFO_TOKEN=
# Set to 1 to use built-in exchange rates and never call the rates service (tests do this).
FX_OFFLINE=

# Email through Resend (resend.com): receipts, newsletter welcome, price-drop alerts, admin broadcasts.
# Without a key nothing is sent; emails are logged as SKIPPED in the admin console.
RESEND_API_KEY=
# The sender; its domain must be verified in Resend.
MAIL_FROM=Omoshow <hello@example.com>
# Rate limits (requests per IP address; counted in memory, so they reset when the API restarts).
# Account sign-ups, newsletter sign-ups and price alerts, each per hour.
SIGNUPS_PER_IP_PER_HOUR=20
# Sign-in attempts per 15 minutes: for one email from one IP, and for any email from one IP.
RATE_LOGIN_PER_IP_EMAIL=10
RATE_LOGIN_PER_IP=30
# "Forgot password" requests per hour (each account also gets at most 3 reset emails an hour).
RATE_FORGOT_PER_IP=5
# "Can't find my order?" requests per IP per hour (each address also gets at most 3 order-list emails an hour)
RATE_FIND_ORDERS_PER_IP=5
# Password resets and changes per hour.
RATE_PASSWORD_PER_IP=10
# Holds and orders (checkout) per 10 minutes, and fan-resale holds per 10 minutes.
RATE_CHECKOUT_PER_IP=30
RATE_RESALE_HOLD_PER_IP=20
# Mobile app: token refreshes and sign-outs per 15 minutes (phones on one carrier can share an IP).
RATE_REFRESH_PER_IP=120
# Door scanners downloading an event's offline ticket pack, per 10 minutes.
RATE_DOOR_PACK_PER_IP=30

# Push notifications to the mobile app through Expo's push service. Works without a token; set EXPO_ACCESS_TOKEN
# only if "enhanced push security" is on for the Expo project. EXPO_PUSH_URL is only changed by tests.
EXPO_ACCESS_TOKEN=
EXPO_PUSH_URL=https://exp.host/--/api/v2/push
